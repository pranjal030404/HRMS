{
  "name": "arthvex-hrms-backend",
  "version": "1.0.0",
  "description": "Arthvex HRMS - multi-tenant HRMS backend (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "db:reset": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:admin": "node --test tests/admin-security.test.js",
    "test:platform": "node --test tests/platform-control-plane.test.js",
    "lifecycle:sweep": "node src/scripts/lifecycle-sweep.js",
    "smoke:platform": "node src/scripts/smoke-platform-console.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1"
  },
  "engines": {
    "node": ">=18"
  }
}
