DB_PASSWORD=HrmsApp@2026
DB_NAME=hrms
JWT_ACCESS_SECRET=arthvex-hrms-dev-access-secret-change-in-production-9f8e7d6c
JWT_REFRESH_SECRET=arthvex-hrms-dev-refresh-secret-change-in-production-1a2b3c4d
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
