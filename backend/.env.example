# --- production only ---------------------------------------------------------
# In production the server refuses to start while any secret above is missing or still the published
# example value. Generate real ones, e.g.:  openssl rand -base64 48   (ENCRYPTION_KEY: exactly 32 chars)
# Shared secret used to verify payment-provider webhooks (POST /api/billing-webhooks/signed).
BILLING_WEBHOOK_SECRET=
# Per-IP API ceiling per minute (production only) and the request log toggle.
API_RATE_LIMIT=600
REQUEST_LOG=on
# NEVER set this on a real database: it allows `db:seed` to wipe every table.
# ALLOW_DESTRUCTIVE_SEED=
